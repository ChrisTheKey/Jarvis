# --- Brain -------------------------------------------------------------------
# The assistant agent (tool routing) and the JARVIS personality pass both run on
# Claude. Without this key the app still runs in "offline" mode: tools work,
# replies are canned.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Ears (speech -> text) ---------------------------------------------------
# Optional. Used to transcribe recorded audio with Whisper. If unset, the
# browser's built-in speech recognition is used instead.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Voice (text -> speech) --------------------------------------------------
# Optional. Gives JARVIS his own voice via ElevenLabs. If unset, the browser's
# speech synthesis is used (pick a British voice in the UI).
ELEVENLABS_API_KEY=
# Voice id carried over from the JARVIS 2.0 n8n workflow.
ELEVENLABS_VOICE_ID=h029Xu7odsKARnf0xDjw
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Server ------------------------------------------------------------------
PORT=3000
