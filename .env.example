# Kopiere diese Datei zu .env und passe sie an.

# Port der Oberfläche (http://localhost:3000)
PORT=3000

# Claude-Modell für Jarvis: sonnet (schnell, gut), opus (am stärksten, langsamer), haiku (am schnellsten)
JARVIS_MODEL=sonnet

# Adresse deiner Netlify-Seite. Nur diese Seite darf den Jarvis auf deinem Rechner steuern.
JARVIS_WEB_ORIGIN=

# 1 = Jarvis darf JEDEN Befehl auf deinem Computer ohne Rückfrage ausführen. Nur einschalten, wenn du das willst.
JARVIS_FULL_ACCESS=0

# Optional: Filmreife Stimme über ElevenLabs (https://elevenlabs.io). Leer lassen = Browser-Stimme.
ELEVENLABS_API_KEY=
# "George" – ruhige britische Männerstimme. Andere Stimmen-IDs findest du in der ElevenLabs Voice Library.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
