{
  "name": "jarvis-claude-code",
  "version": "1.0.0",
  "description": "Sprachgesteuerter Jarvis auf Basis von Claude Code",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:repair-integration": "node scripts/test-repair-integration.mjs",
    "test:release-044": "npm test && npm run test:repair-integration",
    "gmail": "node gmail.js",
    "mail-worker": "node mail-worker.js",
    "mail-plan": "node mail-worker.js --plan",
    "mail-once": "node mail-worker.js --once",
    "lead-finder": "node lead-finder.js --once",
    "build:persona": "node scripts/build-persona.mjs",
    "setup-sync": "node scripts/setup-sync.mjs",
    "test:browser-integration": "node scripts/test-repair-integration.mjs --browser",
    "test:release-045": "npm test && npm run test:repair-integration && npm run test:browser-integration",
    "test:full-order-integration": "node scripts/test-repair-integration.mjs --full-order",
    "test:release-046": "npm test && npm run test:repair-integration && npm run test:browser-integration && npm run test:full-order-integration",
    "readiness": "node production-readiness.js"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.3",
    "playwright-core": "1.60.0",
    "ssh2": "1.17.0"
  }
}
