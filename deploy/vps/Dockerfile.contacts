# Jarvis Lead-Kontaktverzeichnis (TF-051) – eigener Container jarvis-contacts-worker, getrennt vom 24/7-Mail-Worker (jarvis-mail).
# Build-Kontext ist das Repository-Wurzelverzeichnis (siehe deploy/vps/contacts/docker-compose.yml, auf dem VPS /opt/jarvis-contacts/app).
# Enthält bewusst KEIN gmail.js, keinen Mail-Worker und keine Secrets: der Dienst liest das Cold-Register und das Gmail-Register nur
# (read-only Mount), recherchiert öffentliche Firmenseiten und schreibt Verzeichnis + CSV/PDF. Er kann strukturell nicht senden.
FROM node:22-alpine
RUN apk add --no-cache tzdata
ENV NODE_ENV=production TZ=Europe/Zurich JARVIS_CONTACTS_DIR=/data/contacts JARVIS_EXPORTS_DIR=/data/exports JARVIS_MAIL_SECRETS=/data/mail JARVIS_CONTACTS_POLL_SECONDS=120
WORKDIR /app
COPY package.json package-lock.json /app/
RUN npm ci --omit=dev --omit=optional --ignore-scripts --no-audit --no-fund && npm cache clean --force
COPY lead-contacts.js lead-db.js site-auditor.js ./
USER node
ARG JARVIS_COMMIT=unknown
ENV JARVIS_COMMIT=$JARVIS_COMMIT
# Gesund, solange der Dienst sein Lock in den letzten 5 Minuten erneuert hat (Herzschlag jede Minute).
HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 CMD ["node", "lead-contacts.js", "--healthcheck"]
CMD ["node", "lead-contacts.js", "--service"]
