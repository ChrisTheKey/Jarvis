# /opt/jarvis-mail/.env auf dem VPS (chmod 600). Nie ins Git, nie nach Netlify ausser JARVIS_MAIL_WORKER_TOKEN.
# send_authority: derselbe Wert muss in Netlify als JARVIS_MAIL_WORKER_TOKEN gesetzt sein.
JARVIS_MAIL_WORKER_TOKEN=
# Texte für Antworten (statt Claude Code, das auf dem VPS nicht angemeldet ist)
ANTHROPIC_API_KEY=
# Server Control (/api/server-control): eigenes Secret, NICHT der Worker-Token. Derselbe Wert nur noch in Netlify als JARVIS_SERVER_CONTROL_TOKEN.
JARVIS_SERVER_CONTROL_TOKEN=
# Optional
# JARVIS_SYNC_URL=https://chrisjarvis.netlify.app
# JARVIS_MAIL_MODEL=claude-sonnet-5-5
# JARVIS_POLL_MINUTES=2

# ---------- TF-080: Stripe + E2E (NICHT in diese Datei, sondern ausserhalb des Deploys) ----------
# /opt/jarvis-payment/stripe.env  (root:root 0600, NUR Repair-Service; Installation verdeckt: deploy/vps/install-stripe-keys.sh <host> live|test)
#   STRIPE_SECRET_KEY=         sk_live_… / rk_live_… (Restricted Key: Checkout Sessions schreiben/lesen genügt)
#   STRIPE_TEST_SECRET_KEY=    sk_test_… / rk_test_…
# /opt/jarvis-payment/e2e.env     (root:root 0600, Mail-Worker + Repair-Service; deploy/vps/install-stripe-keys.sh <host> e2e)
#   JARVIS_E2E_TEST_ENABLED=false
#   JARVIS_E2E_TEST_DOMAINS=   Sandbox-Domain(s) – nie eine Kundenwebsite
#   JARVIS_E2E_TEST_MAILBOXES= Test-Postfach des Eigentümers (nicht die Jarvis-Absenderadresse)
# Netlify (Webhook-Prüfung, /api/payments): STRIPE_WEBHOOK_SECRET (LIVE, whsec_…), STRIPE_TEST_WEBHOOK_SECRET (TEST, whsec_…)
