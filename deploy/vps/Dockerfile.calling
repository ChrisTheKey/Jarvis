# Jarvis Calling Agent (TF-065) – eigener Container jarvis-calling, getrennt von Mail-Worker, Repair, CRM, Kontaktdienst und VN-Discovery.
# Build-Kontext ist das Repository-Wurzelverzeichnis (siehe deploy/vps/calling/docker-compose.yml, auf dem VPS /opt/jarvis-calling/app).
# Enthält KEIN gmail.js, keinen Mail-Worker, keine Lead-Datenbank: der Dienst holt Anrufaufträge ausgehend von /api/calling (eigener Schlüssel)
# und spricht nur mit LiveKit (Server-API + Agent-Worker). Keine Aufnahme, kein Egress, keine Audiodateien. glibc-Basis wegen @livekit/rtc-node.
FROM node:22-bookworm-slim
ENV NODE_ENV=production TZ=Europe/Zurich JARVIS_CALLING_DIR=/data/calling HOME=/tmp
WORKDIR /app
COPY calling/package.json calling/package-lock.json ./calling/
RUN cd calling && npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY calling-core.js pricing.js ./
COPY public/crm-model.js ./public/
COPY calling/service.js calling/agent.js ./calling/
COPY deploy/vps/calling-derive-token.mjs ./deploy/vps/
RUN printf '{"type":"module","private":true}\n' > package.json
USER node
ARG JARVIS_COMMIT=unknown
ENV JARVIS_COMMIT=$JARVIS_COMMIT
HEALTHCHECK --interval=60s --timeout=10s --start-period=60s --retries=3 CMD ["node", "calling/service.js", "--healthcheck"]
CMD ["node", "calling/service.js", "--service"]
