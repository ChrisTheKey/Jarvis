# Jarvis Vietnam-Discovery (TF-063) – eigener Container jarvis-vn-discovery, getrennt von Mail-Worker, Repair, CRM und Kontaktdienst.
# Build-Kontext ist das Repository-Wurzelverzeichnis (siehe deploy/vps/vn/docker-compose.yml, auf dem VPS /opt/jarvis-vn/app).
# Enthält KEIN gmail.js, keinen Mail-Worker, keine npm-Pakete: der Dienst prüft Websites passiv (nur GET), schreibt nur seinen eigenen
# State (/data/vn) und spricht nur ausgehend mit Overpass, den geprüften Websites und /api/crm (eigener VN-Schlüssel). Er kann nicht senden.
FROM node:22-alpine
RUN apk add --no-cache tzdata
ENV NODE_ENV=production TZ=Asia/Ho_Chi_Minh JARVIS_VN_DIR=/data/vn
WORKDIR /app
COPY package.json vn-discovery.js site-auditor.js site-findings.js lead-crm.js phonebook-compliance.js lead-db.js category-labels.js security-capabilities.js ./
COPY public/crm-model.js public/i18n.js ./public/
COPY data/vietnam-admin.json ./data/
COPY deploy/vps/vn-derive-token.mjs ./deploy/vps/
USER node
ARG JARVIS_COMMIT=unknown
ENV JARVIS_COMMIT=$JARVIS_COMMIT
HEALTHCHECK --interval=60s --timeout=10s --start-period=90s --retries=3 CMD ["node", "vn-discovery.js", "--healthcheck"]
CMD ["node", "vn-discovery.js", "--service"]
